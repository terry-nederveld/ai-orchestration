{
  "name": "overture-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Overture — autonomous agent orchestrator",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --build",
    "desktop:build": "pnpm --filter @overture/ui build && pnpm --filter @overture/desktop build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
