{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overture",
  "version": "0.1.0",
  "identifier": "dev.overture.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Overture — autonomous agent orchestrator",
    "longDescription": "Overture is a local-first control plane for orchestrating autonomous coding agents across work sources, workflows, and providers. This desktop app is a thin shell around the local Overture daemon.",
    "copyright": "",
    "publisher": "Overture",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
