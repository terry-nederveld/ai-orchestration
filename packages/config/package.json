{
  "name": "@overture/config",
  "version": "0.1.0",
  "private": true,
  "description": "Overture layered configuration: defaults, user, project, and run overrides",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --root ../.. --project @overture/config"
  },
  "dependencies": {
    "@overture/core": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
